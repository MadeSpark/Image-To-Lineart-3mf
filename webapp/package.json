{
  "name": "webapp",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "scripts": {
    "sync-version": "node ./scripts/sync-version.mjs",
    "predev": "npm run sync-version",
    "dev": "node ./node_modules/vite/bin/vite.js",
    "prebuild": "npm run sync-version",
    "build": "node ./node_modules/typescript/lib/tsc.js -b && node ./scripts/build-vite.mjs && node ./scripts/inline-dist.mjs",
    "prelint": "npm run sync-version",
    "lint": "eslint .",
    "prepreview": "npm run sync-version",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "precheck": "npm run sync-version",
    "check": "node ./node_modules/typescript/lib/tsc.js -b --noEmit",
    "pretest": "npm run sync-version",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.2",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-dev-locator": "^1.0.6",
    "canvas": "^3.2.3",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
